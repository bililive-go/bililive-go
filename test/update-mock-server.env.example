# bgo 本地升级测试服务器配置示例
# 复制为 test/update-mock-server.env 后填写实际值；实际配置文件已被 .gitignore 忽略。

# HTTP 服务监听地址。需要供局域网、容器或 NAS 访问时通常设为 0.0.0.0。
BGO_UPDATE_BIND_HOST=127.0.0.1

# HTTP 服务监听端口。
BGO_UPDATE_PORT=8888

# 写入下载 URL 的主机名或 IP；请替换为被测 bgo 能访问的开发机地址。
BGO_UPDATE_PUBLIC_HOST=localhost

# 二选一：自动打包本机开发二进制，或直接提供已有 zip/tar.gz 升级包。
# 两项都不设置时，会自动使用当前平台的 bin/bililive-dev[.exe]。
# BGO_UPDATE_SOURCE=bin/bililive-dev
# BGO_UPDATE_PACKAGE=bin/bililive-linux-amd64.tar.gz

# 版本 API 返回内容。
BGO_UPDATE_VERSION=99.0.0-local.1
BGO_UPDATE_CHANGELOG=本地升级测试版本
BGO_UPDATE_PRERELEASE=false
BGO_UPDATE_ALWAYS_UPDATE=false
